SEC_API_KEY=
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SEC fund abbreviation:type  (rmf|ssf|thaiesg|ordinary)
FUNDS=
PEAK_WINDOW_DAYS=252
DROP_TRIGGERS=5,10,15
# Gross yearly income in baht (before any deduction). Required if any fund is a tax fund. Net taxable
# income is derived: gross - expense deduction - every deduction you record (/paid, /deduct).
ANNUAL_GROSS_INCOME=
# Expense deduction taken off gross first: salary (50%, max 100,000; the default), none, or a fixed amount.
EXPENSE_DEDUCTION=salary
# Legacy alternative to ANNUAL_GROSS_INCOME: net income BEFORE every deduction iwealth tracks (RMF, SSF,
# Thai ESG, /deduct items; the personal allowance is already taken out). Used only when gross is unset.
ANNUAL_NET_INCOME=
# Times are Asia/Bangkok. A RUN_AT before 12:00 ingests the PREVIOUS weekday's NAV (runs Tue-Sat).
RUN_AT=04:00
RETRY_UNTIL=08:00
RETRY_INTERVAL=30m
# Year-end reminder to use remaining deduction room: starts on this date (MM-DD), repeats weekly,
# then daily over the last 5 days of the year. "off" disables.
YEAR_END_REMINDER_FROM=12-01
CONTEXT_PROVIDERS=benchmark
# SEC fund abbreviations (comma-separated) used for market comparison. Empty = your tracked funds' own history.
# Codes not in FUNDS are fetched daily too (history only, never alerted).
BENCHMARKS=
RSS_URLS=
SEARCH_API_URL=
SEARCH_API_KEY=
# SQLite file and tax rules file; both default to the working directory.
DB_PATH=iwealth.db
TAX_RULES_PATH=tax_rules.yaml
