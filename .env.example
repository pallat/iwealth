SEC_API_KEY=
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SEC fund abbreviation:type  (rmf|ssf|thaiesg|ordinary)
FUNDS=
PEAK_WINDOW_DAYS=252
DROP_TRIGGERS=5,10,15
# Net taxable income in baht BEFORE every deduction iwealth tracks (RMF/SSF/Thai ESG and the /deduct items
# such as PVD or pension insurance); other deductions (family, life insurance, ...) are already taken out.
# Required if any fund is a tax fund.
ANNUAL_NET_INCOME=
# Optional: gross annual income (before any deduction). Enables the %-of-income limits in tax_rules.yaml.
ANNUAL_GROSS_INCOME=
RUN_AT=20:00
RETRY_UNTIL=23:30
RETRY_INTERVAL=30m
CONTEXT_PROVIDERS=benchmark
# SEC fund abbreviations (comma-separated) used for market comparison. Empty = your tracked funds' own history.
# Codes not in FUNDS are fetched daily too (history only, never alerted).
BENCHMARKS=
RSS_URLS=
SEARCH_API_URL=
SEARCH_API_KEY=
# SQLite file and tax rules file; both default to the working directory.
DB_PATH=iwealth.db
TAX_RULES_PATH=tax_rules.yaml
